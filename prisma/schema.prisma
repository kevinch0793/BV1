// Tailored Resume Platform — data model
// Prisma 7 (queryCompiler + driver adapter). See lib/db.ts for the libSQL adapter wiring.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// A tenant account. Clients self-register (status "pending") and an admin
/// approves them before they can log in. There is one seeded admin.
model Client {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         String    @default("client") // "admin" | "client"
  status       String    @default("pending") // "pending" | "approved" | "rejected"
  // The plan NEW profiles of this client inherit. The plan itself lives on the
  // profile (a client may run one candidate per plan), but approval happens at
  // the client level and usually before any profile exists — so the admin picks
  // the default here when approving.
  defaultPlan  String    @default("tailor") // "normal" | "tailor"
  createdAt    DateTime  @default(now())
  approvedAt   DateTime?

  profiles Profile[]
  settings Settings?
  events   CalendarEvent[]
  answerTokens AnswerToken[]
}

/// A per-profile token for the application-answer browser extension. A client can
/// have several (one per candidate profile), each answering as its own profile —
/// so two candidates can use the extension at the same time without overwriting
/// each other. Only the SHA-256 of the raw token is stored.
model AnswerToken {
  id         String    @id @default(cuid())
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  profileId  String
  profile    Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([clientId])
}

/// A manually-managed calendar event (Google/Outlook-style). Dates/times are
/// stored as wall-clock strings (no timezone) since a calendar day is a label,
/// not an instant.
model CalendarEvent {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  profileId String? // optional tag to a profile (not an FK; resolved in the UI)
  title     String // legacy; kept in sync with `company` (NOT NULL)
  company   String? // company we're interviewing with (shown on the calendar bar)
  role      String? // role we're applying to
  date      String // start day, "YYYY-MM-DD"
  endDate   String? // end day for multi-day events, "YYYY-MM-DD" (defaults to date)
  allDay    Boolean  @default(true)
  startTime String? // "HH:MM" (24h), when not all-day
  endTime   String? // "HH:MM" (24h)
  timeZone  String? // IANA zone the wall-clock date/startTime are anchored to (timed events)
  location  String?
  note      String?
  meetingType String? // "phone" | "video" (interview events)
  meetingLink String? // video meeting URL, when meetingType = "video"
  step      String? // interview stage: intro | hr | tech | onsite | final | offer
  status    String? // interview outcome: failed (null = not failed)
  statusNote String? // reason, e.g. "why failed"
  color     String   @default("sky")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, date])
}

/// Per-client app settings (one row per Client).
model Settings {
  id                 String   @id @default(cuid())
  clientId           String   @unique
  client             Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  customInstructions String? // extra guidance appended to every tailoring
  skillsPosition     String   @default("after") // legacy; superseded by sectionOrder
  sectionOrder       String   @default("summary,experience,skills,education") // resume section render order
  defaultTemplate    String   @default("modern") // default resume template id
  resumeFont         String   @default("default") // resume font family id (default = template's own fonts)
  resumeAccent       String   @default("default") // resume accent color id (default = template's own colors)
  resumeFontScale    Int      @default(100) // deprecated: font-size feature removed; column kept but unused
  tailoringModel     String   @default("claude-sonnet-4-6") // DEPRECATED: superseded by the global, admin-set AppConfig.tailoringModel (applies to ALL clients). Column kept for back-compat; no longer read.
  // Skills-section size: the resume fills to this range (drawing on the profile's
  // own skills + role-relevant defaults) even when the JD lists few skills.
  skillsMinCategories Int     @default(4)
  skillsMaxCategories Int     @default(6)
  skillsMinItems      Int     @default(6)
  skillsMaxItems      Int     @default(9)
  updatedAt          DateTime @updatedAt
}

/// App-wide configuration — a single row (id = "global"). Admin-controlled and
/// shared across ALL clients, unlike per-client Settings. Currently just the
/// tailoring model used for every resume tailoring, regardless of profile owner.
model AppConfig {
  id             String   @id @default("global")
  tailoringModel String   @default("claude-sonnet-4-6") // Claude model used for ALL tailoring (admin-set)
  // Admin notice shown to EVERY signed-in client (see components/NoticeBanner).
  // noticeActive is separate from the text so a notice can be switched off and
  // back on without retyping it. noticeUpdatedAt is what makes an edited notice
  // re-appear for people who already dismissed the previous one.
  noticeText      String? // null/blank = nothing to show
  noticeKind      String    @default("info") // info | success | warning | critical
  noticeActive    Boolean   @default(false)
  noticeUpdatedAt DateTime?
  // Companies this platform never applies to, one per line ("#" starts a comment).
  // Matched when URLs are pasted (against the board's company slug) and again
  // after extraction (against the real company name) -- see lib/blacklist.ts.
  companyBlacklist String?
  updatedAt      DateTime @updatedAt
}

/// A distinct identity used to generate resumes (name, contact, history).
model Profile {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label     String // e.g. "ML Engineer", "Eng Manager"
  fullName  String
  email     String?
  phone     String?
  location  String?
  links     Json? // { linkedin, github, portfolio, ... }
  summary   String?
  templateId   String? // per-profile resume template id; null = default ("modern")
  resumeFont   String? // per-profile font family id; null = default
  resumeAccent String? // per-profile accent color id; null = default
  paused    Boolean  @default(false) // admin pause: stops this profile's fetch+tailor pipeline and blocks add/refetch
  // "tailor" = jobs are fetched AND tailored. "normal" = fetched only, so the
  // candidate applies with one fixed resume and the expensive tailor call is
  // never made. Defaults to "tailor", so existing profiles are unaffected.
  plan      String   @default("tailor") // "normal" | "tailor"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  experiences Experience[]
  education   Education[]
  skills      Skill[]
  baseResume  BaseResume?
  fixedResume FixedResume?
  jobs        JobPosting[]
  tailored    TailoredResume[]
  answerTokens AnswerToken[]
}

model Experience {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  company   String
  role      String
  location  String?
  startDate String?
  endDate   String?
  current   Boolean  @default(false)
  projects  Json? // [{ name, type, domain, bullets: string[] }] — per-company subgroups (theme)
  order     Int      @default(0)
}

model Education {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  school    String
  degree    String?
  field     String?
  startDate String?
  endDate   String?
  gpa       String?
  order     Int     @default(0)
}

model Skill {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  category  String?
}

/// Optional original resume text used by the "tailor from base" mode.
model BaseResume {
  id        String   @id @default(cuid())
  profileId String   @unique
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  rawText   String
  updatedAt DateTime @updatedAt
}

/// The one fixed resume a "normal"-plan candidate attaches to every application.
/// Stored as bytes in the database rather than on disk so the nightly SQLite
/// backup covers it — a file on the volume would sit outside every backup.
/// One per profile; re-uploading replaces it.
model FixedResume {
  id        String   @id @default(cuid())
  profileId String   @unique
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  filename  String // as uploaded — its extension drives the download's name
  mimeType  String // application/pdf | ...wordprocessingml.document
  bytes     Bytes
  size      Int // stored separately so a listing never has to load the blob
  updatedAt DateTime @updatedAt
}

/// A job the user wants to apply to, scraped or pasted.
model JobPosting {
  id                String   @id @default(cuid())
  profileId         String
  profile           Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  url               String?
  company           String?
  role              String?
  location          String?
  workplace         String? // remote | hybrid | in-person | onsite | unknown (LLM-classified; "unknown" = the posting stated no mode, which is tailored rather than skipped)
  descriptionRaw    String?
  descriptionParsed Json? // { description, requirements[] }
  // pending | fetching | fetched | needs_jd | tailoring | skipped | excluded | failed
  // "skipped" is terminal: fetched successfully but not fully remote, so the
  // pipeline deliberately did not tailor it (see shouldTailorWorkplace).
  status            String   @default("pending")
  error             String? // last fetch error, when status = failed
  createdAt         DateTime @default(now())
  applyStatus       String   @default("none") // none | applied | not_available
  appliedAt         DateTime? // when the user marked it applied
  appliedTailored   Boolean? // did the application use a tailored resume?

  tailored TailoredResume[]

  // The pipeline and the dashboard both filter by profile + status (queue
  // gathering, the mid-flight status recovery on start) and by profile + date
  // (the day view, which the dashboard re-renders on every poll). Without these
  // every such query is a full table scan, which also lengthens how long the
  // single SQLite writer holds its lock.
  @@index([profileId, status])
  @@index([profileId, createdAt])
}

/// A generated, JD-tailored resume tied to a profile (and optionally a job).
model TailoredResume {
  id           String      @id @default(cuid())
  profileId    String
  profile      Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobPostingId String?
  // Removing a job removes its tailored resume too, so it stops counting in
  // totals and never lingers in history. Manual resumes (no job) are unaffected.
  job          JobPosting? @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  templateId   String      @default("classic")
  mode         String // with_base | from_scratch
  instructions String?
  content      Json // ResumeContent
  fitBefore    Int? // ATS keyword-coverage % of the base resume (before tailoring)
  fitAfter     Int? // ATS keyword-coverage % of this tailored resume
  fitDetail    Json? // { jdSkills:{hardSkills,themes}, matched:[], missing:[] }
  createdAt    DateTime    @default(now())

  // Prisma does not index foreign keys on SQLite. Without these, the pipeline's
  // queue query — fetched jobs with no tailored resume, i.e. a NOT EXISTS on
  // jobPostingId — scanned this whole table once per candidate job, and the
  // cascade delete on job pruning did the same. Measured at 16k rows: 8.7s to
  // return nothing, on every round of the loop and at every startup resume.
  @@index([jobPostingId])
  @@index([profileId])
}

/// One LLM call's usage — tokens + latency — for the admin analytics dashboard.
/// Plain string ids (NO FKs) so a client's usage history survives profile/job
/// pruning. Written from the LLM wrappers via AsyncLocalStorage (lib/llm/usage.ts).
model UsageEvent {
  id           String   @id @default(cuid())
  clientId     String
  profileId    String?
  jobId        String?
  kind         String // tailor | fetch | jd_skills | answer | parse
  provider     String // anthropic | openai
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  ms           Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([createdAt])
}

// An OpenAI API key the admin can switch between from /admin/keys.
//
// Keys used to live only in .env, which meant changing one required editing the
// file and recreating the container (compose reads env_file at create time, so a
// plain restart keeps the old value). Holding them here lets a switch take effect
// on the next request. OPENAI_API_KEY is still honoured as a fallback when no row
// is active, so the platform keeps working if this table is empty.
//
// `last6` exists so the UI can identify a key without ever receiving `secret`.
model ApiKey {
  id        String  @id @default(cuid())
  label     String // admin-facing name, e.g. "Main account"
  secret    String // the key itself; never sent to the browser
  last6     String // display suffix, e.g. "Q8OIYA"
  active    Boolean @default(false) // exactly one row should be active
  // Result of the last live probe. Kept so the list renders instantly before the
  // page re-checks, and so a key's history is visible after it dies.
  lastStatus    String? // ok | revoked | no_credit | rate_limited | error
  lastDetail    String?
  lastCheckedAt DateTime?
  createdAt     DateTime @default(now())

  @@index([active])
}
